<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SharpClaw.Persistence.JSONColdStore</PackageId>
    <Description>SharpClaw persistence module backed by JSONColdStore.</Description>
    <PackageTags>SharpClaw;persistence;storage;json;cold-store</PackageTags>
    <PersistenceModuleId>sharpclaw_persistence_jsoncoldstore</PersistenceModuleId>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackPersistenceModulePayload</TargetsForTfmSpecificContentInPackage>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="SharpClaw.Contracts" />
    <PackageReference Include="SharpClaw.ModuleSDK" PrivateAssets="all" IncludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="Supprocom.JSONColdStore" />
    <ProjectReference Include="..\SharpClaw.Persistence\SharpClaw.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="package.json"
             Link="contributions\sharpclaw_persistence_jsoncoldstore\package.json"
             CopyToOutputDirectory="PreserveNewest"
             Pack="true"
             PackagePath="contentFiles\any\$(TargetFramework)\contributions\sharpclaw_persistence_jsoncoldstore\package.json"
             PackageCopyToOutput="true" />
  </ItemGroup>
</Project>
