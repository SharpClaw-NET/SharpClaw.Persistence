<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SharpClaw.Persistence</PackageId>
    <Description>Provider-neutral persistence contracts and Entity Framework model for SharpClaw.</Description>
    <PackageTags>SharpClaw;persistence;storage;entity-framework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="SharpClaw.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpClaw.Runtime.INF" />
  </ItemGroup>
</Project>
